{
  "name": "mon-devis-sans-oublis-frontend",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.4"
    }
  },
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next out",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fresh": "rm -rf .next out node_modules pnpm-lock.yaml && pnpm install",
    "lint": "next lint",
    "start": "serve out -l ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint"
  },
  "dependencies": {
    "@gouvfr/dsfr": "1.14.2",
    "next": "^15.5.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "serve": "^14.2.4",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.8",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.8"
  },
  "engines": {
    "node": "24"
  }
}
